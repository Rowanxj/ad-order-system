{
  "version": 1,
  "note": "运行时验收契约。每条 case 是一次真实 HTTP 调用，按顺序执行，可用 capture 捕获上一步返回值供后续 {变量} 使用。expect 是业务 code（0 成功），不是 HTTP 状态码——本项目的错误一律以 HTTP 200 + {code,message} 返回。",
  "baseUrl": "http://localhost:8080/api",
  "accounts": {
    "sales": { "username": "sales", "password": "123456" },
    "manager": { "username": "manager", "password": "123456" },
    "designer1": { "username": "designer1", "password": "123456" },
    "designer2": { "username": "designer2", "password": "123456" }
  },
  "cases": [
    { "id": "C01", "name": "未登录访问订单列表 → 401", "as": null, "method": "GET", "path": "/orders", "expect": 401 },
    { "id": "C02", "name": "客户经理创建含 2 项物料的订单", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "契约验收-主链路", "description": "check-api 自动创建", "deadline": "2026-12-30",
        "tasks": [
          { "materialType": "POSTER", "name": "验收海报", "spec": "600x900mm", "quantity": 2, "deadline": "2026-12-20" },
          { "materialType": "STAND", "name": "验收展架", "spec": "800x1800mm", "quantity": 1, "deadline": "2026-12-25" }
        ] },
      "expect": 0, "capture": { "oid": "data.id" } },
    { "id": "C03", "name": "读订单详情并取出两个任务 ID", "as": "sales", "method": "GET", "path": "/orders/{oid}", "expect": 0,
      "capture": { "t1": "data.tasks.0.id", "t2": "data.tasks.1.id" } },

    { "id": "C04", "name": "订单未确认时不能交付(409)", "as": "manager", "method": "PUT", "path": "/orders/{oid}/complete", "expect": 409 },
    { "id": "C05", "name": "设计人员不能确认订单(403)", "as": "designer1", "method": "PUT", "path": "/orders/{oid}/confirm", "expect": 403 },
    { "id": "C06", "name": "负责人确认订单", "as": "manager", "method": "PUT", "path": "/orders/{oid}/confirm", "expect": 0 },
    { "id": "C07", "name": "重复确认订单(409)", "as": "manager", "method": "PUT", "path": "/orders/{oid}/confirm", "expect": 409 },
    { "id": "C08", "name": "确认后新增物料任务（须留痕）", "as": "sales", "method": "POST", "path": "/orders/{oid}/tasks",
      "json": { "materialType": "ONLINE", "name": "验收加配图", "quantity": 3, "deadline": "2026-12-28" }, "expect": 0 },
    { "id": "C09", "name": "确认后修改整体截止日期（须留痕）", "as": "sales", "method": "PUT", "path": "/orders/{oid}/deadline",
      "json": { "deadline": "2026-12-31" }, "expect": 0 },

    { "id": "C10", "name": "负责人分派任务 1 给 designer1", "as": "manager", "method": "PUT", "path": "/tasks/{t1}/assign",
      "json": { "assigneeId": 3 }, "expect": 0 },
    { "id": "C11", "name": "开始前允许改派给 designer2", "as": "manager", "method": "PUT", "path": "/tasks/{t1}/assign",
      "json": { "assigneeId": 4 }, "expect": 0 },
    { "id": "C12", "name": "改派回 designer1", "as": "manager", "method": "PUT", "path": "/tasks/{t1}/assign",
      "json": { "assigneeId": 3 }, "expect": 0 },
    { "id": "C12B", "name": "负责人分派任务 2 给 designer2", "as": "manager", "method": "PUT", "path": "/tasks/{t2}/assign",
      "json": { "assigneeId": 4 }, "expect": 0 },
    { "id": "C13", "name": "designer2 操作他人任务(403)", "as": "designer2", "method": "PUT", "path": "/tasks/{t1}/start", "expect": 403 },
    { "id": "C14", "name": "designer1 开始设计", "as": "designer1", "method": "PUT", "path": "/tasks/{t1}/start", "expect": 0 },
    { "id": "C15", "name": "designer1 上传第 1 版设计稿", "as": "designer1", "method": "POST", "path": "/tasks/{t1}/versions",
      "upload": { "field": "file", "fileName": "design-v1.png", "text": "contract-check fixture" }, "expect": 0 },
    { "id": "C16", "name": "未进入待客户确认的任务不能直接确认(409)", "as": "sales", "method": "PUT", "path": "/tasks/{t2}/confirm", "expect": 409 },

    { "id": "C17", "name": "客户经理记录修改意见", "as": "sales", "method": "POST", "path": "/tasks/{t1}/feedbacks",
      "json": { "content": "颜色改成奶茶棕" }, "expect": 0 },
    { "id": "C18", "name": "修改中可再上传第 2 版", "as": "designer1", "method": "POST", "path": "/tasks/{t1}/versions",
      "upload": { "field": "file", "fileName": "design-v2.png", "text": "contract-check fixture v2" }, "expect": 0 },
    { "id": "C19", "name": "设计人员不能记录客户确认(403)", "as": "designer1", "method": "PUT", "path": "/tasks/{t1}/confirm", "expect": 403 },
    { "id": "C20", "name": "客户经理记录客户确认", "as": "sales", "method": "PUT", "path": "/tasks/{t1}/confirm", "expect": 0 },
    { "id": "C21", "name": "已确认任务不能改截止日期(409)", "as": "sales", "method": "PUT", "path": "/tasks/{t1}/deadline",
      "json": { "deadline": "2026-12-19" }, "expect": 409 },

    { "id": "C22", "name": "还有未确认任务时整单不能交付(409)", "as": "manager", "method": "PUT", "path": "/orders/{oid}/complete", "expect": 409 },
    { "id": "C23", "name": "designer2 开始任务 2", "as": "designer2", "method": "PUT", "path": "/tasks/{t2}/start", "expect": 0 },
    { "id": "C24", "name": "designer2 上传任务 2 版本", "as": "designer2", "method": "POST", "path": "/tasks/{t2}/versions",
      "upload": { "field": "file", "fileName": "stand-v1.png", "text": "contract-check fixture" }, "expect": 0 },
    { "id": "C25", "name": "客户经理确认任务 2", "as": "sales", "method": "PUT", "path": "/tasks/{t2}/confirm", "expect": 0 },
    { "id": "C26", "name": "仍有未分派任务时整单不能交付(409)", "as": "manager", "method": "PUT", "path": "/orders/{oid}/complete", "expect": 409 },

    { "id": "C27", "name": "客户经理再创建一笔单任务订单（用于越权读测试）", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "契约验收-越权基线", "description": "不含 designer1 任务", "deadline": "2026-12-30",
        "tasks": [ { "materialType": "BROCHURE", "name": "越权基线物料", "quantity": 1, "deadline": "2026-12-29" } ] },
      "expect": 0, "capture": { "oid2": "data.id" } },
    { "id": "C28", "name": "designer1 读取与自己无关的订单(403)", "as": "designer1", "method": "GET", "path": "/orders/{oid2}", "expect": 403 },
    { "id": "C29", "name": "订单详情包含任务列表与操作历史", "as": "sales", "method": "GET", "path": "/orders/{oid}", "expect": 0,
      "expectFields": ["data.tasks", "data.logs"] },
    { "id": "C30", "name": "改期与新增物料确实写入操作历史", "as": "sales", "method": "GET", "path": "/orders/{oid}", "expect": 0,
      "expectContains": ["ORDER_DEADLINE_CHANGED", "TASK_ADDED"] },

    { "id": "C31", "name": "订单列表分页：第 1 页每页 2 条", "as": "sales", "method": "GET", "path": "/orders?page=1&size=2",
      "expect": 0, "expectFields": ["data.list", "data.total", "data.page", "data.size"], "expectArrayLength": { "data.list": 2 } },
    { "id": "C32", "name": "订单列表分页：第 2 页可翻页", "as": "sales", "method": "GET", "path": "/orders?page=2&size=2",
      "expect": 0, "expectFields": ["data.list", "data.total"] },
    { "id": "C33", "name": "分页 size 超上限被截断但不报错", "as": "sales", "method": "GET", "path": "/orders?page=1&size=999",
      "expect": 0, "expectFields": ["data.size"] },

    { "id": "C34", "name": "非法物料类型被拒绝(400)", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "非法类型测试", "deadline": "2026-12-30",
        "tasks": [ { "materialType": "BILLBOARD", "name": "户外大牌", "quantity": 1 } ] },
      "expect": 400 },
    { "id": "C35", "name": "物料数量为 0 被拒绝(400)", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "数量校验测试", "deadline": "2026-12-30",
        "tasks": [ { "materialType": "POSTER", "name": "海报", "quantity": 0 } ] },
      "expect": 400 },
    { "id": "C36", "name": "路径参数类型错误返回 400 而不是 500", "as": "sales", "method": "GET", "path": "/orders/abc", "expect": 400 },

    { "id": "C37", "name": "客户经理创建一笔将被取消的订单", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "契约验收-取消后守卫", "deadline": "2026-12-30",
        "tasks": [ { "materialType": "MENU", "name": "取消前菜单", "quantity": 1, "deadline": "2026-12-20" } ] },
      "expect": 0, "capture": { "oid3": "data.id" } },
    { "id": "C38", "name": "取出待取消订单的任务 ID", "as": "sales", "method": "GET", "path": "/orders/{oid3}", "expect": 0,
      "capture": { "t4": "data.tasks.0.id" } },
    { "id": "C39", "name": "取消前先把任务分派给 designer1", "as": "manager", "method": "PUT", "path": "/tasks/{t4}/assign",
      "json": { "assigneeId": 3 }, "expect": 0 },
    { "id": "C40", "name": "客户经理取消该订单", "as": "sales", "method": "PUT", "path": "/orders/{oid3}/cancel", "expect": 0 },
    { "id": "C41", "name": "订单已取消，设计人员不能再开始设计(409)", "as": "designer1", "method": "PUT", "path": "/tasks/{t4}/start", "expect": 409 },
    { "id": "C42", "name": "订单已取消，不能再新增物料(409)", "as": "sales", "method": "POST", "path": "/orders/{oid3}/tasks",
      "json": { "materialType": "POSTER", "name": "取消后加料", "quantity": 1 }, "expect": 409 },
    { "id": "C43", "name": "负责人获取待办提醒（含待确认/待分派/可交付）", "as": "manager", "method": "GET", "path": "/notifications/summary",
      "expect": 0, "expectFields": ["data.serverTime", "data.total", "data.items", "data.recent"] },
    { "id": "C44", "name": "设计人员获取待办提醒（只看自己的任务）", "as": "designer1", "method": "GET", "path": "/notifications/summary",
      "expect": 0, "expectFields": ["data.items", "data.recent"] },
    { "id": "C45", "name": "未登录不能获取待办提醒(401)", "as": null, "method": "GET", "path": "/notifications/summary", "expect": 401 },
    { "id": "C46", "name": "身份与账号不匹配时拒绝登录(403)", "as": null, "method": "POST", "path": "/auth/login",
      "json": { "username": "sales", "password": "123456", "role": "DESIGNER" }, "expect": 403 },
    { "id": "C47", "name": "身份与账号匹配时可登录", "as": null, "method": "POST", "path": "/auth/login",
      "json": { "username": "manager", "password": "123456", "role": "MANAGER" }, "expect": 0 },
    { "id": "C48", "name": "负责人获取订单大盘统计", "as": "manager", "method": "GET", "path": "/orders/stats",
      "expect": 0, "expectFields": ["data.orderPendingConfirm", "data.taskPending", "data.taskPendingConfirm", "data.scope"] },
    { "id": "C49", "name": "设计人员的统计口径是自己的任务", "as": "designer1", "method": "GET", "path": "/orders/stats",
      "expect": 0, "expectFields": ["data.scope", "data.taskPending"] },

    { "id": "C50", "name": "客户经理创建任务工作台筛选基线订单（两项待分派）", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "契约验收-任务工作台", "description": "check-api 自动创建", "deadline": "2026-12-30",
        "tasks": [
          { "materialType": "POSTER", "name": "FILTER_TASK_A", "quantity": 1, "deadline": "2026-12-20" },
          { "materialType": "STAND", "name": "FILTER_TASK_B", "quantity": 1, "deadline": "2026-12-25" }
        ] },
      "expect": 0, "capture": { "oid4": "data.id" } },
    { "id": "C51", "name": "取出任务工作台基线订单的两个任务 ID", "as": "sales", "method": "GET", "path": "/orders/{oid4}", "expect": 0,
      "capture": { "wt1": "data.tasks.0.id", "wt2": "data.tasks.1.id" } },
    { "id": "C52", "name": "负责人把 FILTER_TASK_B 分派给 designer1", "as": "manager", "method": "PUT", "path": "/tasks/{wt2}/assign",
      "json": { "assigneeId": 3 }, "expect": 0 },

    { "id": "C53", "name": "任务工作台按逾期筛选（演示数据里的逾期任务）", "as": "manager", "method": "GET", "path": "/tasks?overdue=true&page=1&size=100",
      "expect": 0, "expectFields": ["data.list", "data.total", "data.page", "data.size"], "expectContains": ["开业主海报"] },
    { "id": "C54", "name": "任务工作台按未分派筛选", "as": "manager", "method": "GET", "path": "/tasks?unassigned=true&page=1&size=100",
      "expect": 0, "expectFields": ["data.list"], "expectContains": ["FILTER_TASK_A"] },
    { "id": "C55", "name": "任务工作台按订单筛选（该订单 2 项任务）", "as": "manager", "method": "GET", "path": "/tasks?orderId={oid4}&page=1&size=100",
      "expect": 0, "expectArrayLength": { "data.list": 2 }, "expectContains": ["FILTER_TASK_A", "FILTER_TASK_B"] },
    { "id": "C56", "name": "任务工作台按状态与分派人筛选", "as": "manager", "method": "GET", "path": "/tasks?status=PENDING&assigneeId=3&page=1&size=100",
      "expect": 0, "expectContains": ["FILTER_TASK_B"] },
    { "id": "C57", "name": "任务工作台关键词筛选（1 条）", "as": "manager", "method": "GET", "path": "/tasks?keyword=FILTER_TASK_B&page=1&size=100",
      "expect": 0, "expectArrayLength": { "data.list": 1 }, "expectContains": ["FILTER_TASK_B"] },
    { "id": "C58", "name": "任务工作台分页：第 1 页每页 2 条", "as": "manager", "method": "GET", "path": "/tasks?page=1&size=2",
      "expect": 0, "expectFields": ["data.list", "data.total", "data.page", "data.size"], "expectArrayLength": { "data.list": 2 } },
    { "id": "C59", "name": "设计人员不能访问任务工作台(403)", "as": "designer1", "method": "GET", "path": "/tasks", "expect": 403 },

    { "id": "C60", "name": "客户经理也能访问任务工作台（角色放宽）", "as": "sales", "method": "GET", "path": "/tasks?page=1&size=2",
      "expect": 0, "expectFields": ["data.list", "data.total", "data.page", "data.size"] },
    { "id": "C61", "name": "订单列表支持只看逾期", "as": "manager", "method": "GET", "path": "/orders?overdue=true&page=1&size=10",
      "expect": 0, "expectFields": ["data.list", "data.total"] },
    { "id": "C62", "name": "订单列表支持只看已延期", "as": "manager", "method": "GET", "path": "/orders?extended=true&page=1&size=10",
      "expect": 0, "expectFields": ["data.list", "data.total"] },
    { "id": "C63", "name": "整体截止日期早于今天被拒绝(400)", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "日期校验-整体过去", "deadline": "2020-01-01",
        "tasks": [ { "materialType": "POSTER", "name": "日期校验物料", "quantity": 1, "deadline": "2020-01-01" } ] },
      "expect": 400 },
    { "id": "C64", "name": "物料截止晚于整体截止被拒绝(400)", "as": "sales", "method": "POST", "path": "/orders",
      "json": { "customerId": 1, "title": "日期校验-顺序倒置", "deadline": "2026-12-30",
        "tasks": [ { "materialType": "POSTER", "name": "日期校验物料", "quantity": 1, "deadline": "2027-01-15" } ] },
      "expect": 400 },
    { "id": "C65", "name": "整体截止不能早于最晚物料截止(400)", "as": "manager", "method": "PUT", "path": "/orders/{oid4}/deadline",
      "json": { "deadline": "2026-12-21" }, "expect": 400 }
  ]
}
