# 后端环境变量模板（复制为 .env 或直接在启动前 set）
#
# 说明：Spring Boot 通过 ${VAR:默认值} 读取。application.yml 里已经写成
#   password: "${DB_PASSWORD:}"
# **必须设置**下面标了「部署必填」的项，否则后端连不上数据库。
#
# 用法（PowerShell）：
#   $env:DB_PASSWORD="真实密码"
#   $env:JWT_SECRET="<32 字节以上的随机串>"
#   java -jar target\ad-order-backend-1.0.0.jar

# ---------- 服务 ----------
# 后端端口（默认 8080）
SERVER_PORT=8080

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://localhost:3306/ad_order_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
# 部署必填：填你自己的 MySQL root 口令
DB_PASSWORD=

# ---------- 认证 ----------
# 部署必填：生成方式（PowerShell）
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=adorder-course-project-jwt-secret-key-2026-aipbl
JWT_EXPIRE_HOURS=24
# 仅用于兼容历史 SHA-256 密码格式；新密码已使用 PBKDF2 随机盐
PASSWORD_SALT=adorder

# ---------- 文件 ----------
# 设计稿上传目录（相对后端运行目录）
UPLOAD_DIR=./uploads

# ---------- 日志（推荐在启动命令里传，见 scripts/start-backend.ps1） ----------
# LOG_FILE=logs/app.log
# LOG_LEVEL=info
